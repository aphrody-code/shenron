{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"],
			"env": [
				"NODE_ENV",
				"VERCEL_URL",
				"DATABASE_URL",
				"BETTER_AUTH_URL",
				"BETTER_AUTH_SECRET",
				"NEXTAUTH_URL",
				"NEXTAUTH_SECRET",
				"AUTH_URL",
				"AUTH_SECRET",
				"DISCORD_CLIENT_ID",
				"DISCORD_CLIENT_SECRET",
				"AUTH_DISCORD_ID",
				"AUTH_DISCORD_SECRET",
				"DISCORD_PUBLIC_KEY",
				"DISCORD_APPLICATION_ID",
				"SHENRON_API_URL",
				"NEXT_PUBLIC_DISCORD_INVITE_URL",
				"NEXT_PUBLIC_SITE_URL"
			]
		},
		"lint": {},
		"type-check": {},
		"test": {},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"start": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["^build"]
		}
	}
}
