{
	"name": "shenron-monorepo",
	"version": "0.1.0",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"react": "19.3.0-canary-d9f4e76b-20260903",
			"react-dom": "19.3.0-canary-d9f4e76b-20260903",
			"next": "16.4.0-canary.17",
			"@next/bundle-analyzer": "16.4.0-canary.17",
			"@next/eslint-plugin-next": "16.4.0-canary.17",
			"eslint-config-next": "16.4.0-canary.17",
			"typescript": "6.0.3",
			"tailwindcss": "^4.3.3",
			"@supabase/supabase-js": "^2.115.0",
			"@supabase/ssr": "^0.12.5",
			"better-auth": "1.7.2",
			"prisma": "7.10.0",
			"@prisma/client": "7.10.0",
			"@rpbey/discordy": "^0.1.1",
			"discord.js": "^14.27.0",
			"vitest": "^5.0.0",
			"zod": "^4.5.4",
			"@sglkc/kuromoji": "^1.1.0",
			"oxlint": "^1.81.0",
			"oxfmt": "^0.66.0",
			"eslint-plugin-oxlint": "^1.81.0",
			"@types/bun": "^1.4.0",
			"@types/node": "latest",
			"@types/react": "19.2.18",
			"@types/react-dom": "19.2.7",
			"eslint": "^9.39.5",
			"tsup": "^8.5.1",
			"sqlite-vec": "^0.1.1",
			"@modelcontextprotocol/sdk": "^1.30.0"
		}
	},
	"type": "module",
	"scripts": {
		"bot:dev": "bun --filter @shenron/bot dev",
		"bot:start": "bun --filter @shenron/bot start",
		"bot:build": "bun --filter @shenron/bot build",
		"bot:test": "bun --filter @shenron/bot test",
		"bot:lint": "bun --filter @shenron/bot lint",
		"site:dev": "bun --filter @shenron/site dev",
		"site:build": "bun --filter @shenron/site build",
		"site:start": "bun --filter @shenron/site start",
		"mcp:dev": "bun --filter @shenron/mcp dev",
		"mcp:start": "bun --filter @shenron/mcp start",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"build": "turbo run build",
		"dev": "turbo run dev",
		"test": "turbo run test",
		"test:all": "bun scripts/test-all.ts",
		"test:ci": "bun scripts/test-all.ts --strict",
		"test:cov": "bun scripts/test-all.ts --coverage --junit",
		"test:live": "bun scripts/test-all.ts --live",
		"rag:eval": "bun --filter @shenron/bot rag:eval",
		"type-check": "turbo run type-check",
		"clean": "turbo run clean && rm -rf node_modules .turbo",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"docs:unify": "bun scripts/docs/unify-markdown.ts"
	},
	"dependencies": {
		"sharp": "^0.35.4",
		"vercel": "^59.11.7"
	},
	"devDependencies": {
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"tsup": "^8.5.1",
		"turbo": "^2.10.12"
	},
	"overrides": {
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"next": "16.4.0-canary.17",
		"react": "19.3.0-canary-d9f4e76b-20260903",
		"react-dom": "19.3.0-canary-d9f4e76b-20260903"
	},
	"packageManager": "bun@1.3.14",
	"comment-overrides": "Force une copie UNIQUE de @types/react (sinon skew 19.2.14/19.2.15 entre workspaces → casse l'augmentation JSX @pixi/react et les types Base UI)."
}
