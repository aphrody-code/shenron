{
	"name": "shenron-monorepo",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"comment-overrides": "Force une copie UNIQUE de @types/react (sinon skew 19.2.14/19.2.15 entre workspaces → casse l'augmentation JSX @pixi/react et les types Base UI).",
	"overrides": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"next": "16.3.0-canary.37",
		"@types/react": "19.2.15",
		"@types/react-dom": "19.2.3"
	},
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"react": "^19.0.0",
			"react-dom": "^19.0.0",
			"next": "16.3.0-canary.37",
			"@next/bundle-analyzer": "^16.2.6",
			"@next/eslint-plugin-next": "^16.2.6",
			"eslint-config-next": "^16.2.6",
			"typescript": "next",
			"tailwindcss": "^4.2.2",
			"@supabase/supabase-js": "^2.89.0",
			"@supabase/ssr": "^0.6.1",
			"better-auth": "1.6.11",
			"prisma": "7.7.0",
			"@prisma/client": "7.7.0",
			"@rpbey/discordy": "^0.1.1",
			"discord.js": "^14.26.3",
			"vitest": "^4.0.18",
			"zod": "^4.4.3",
			"oxlint": "^1.64.0",
			"oxfmt": "^0.53.0",
			"eslint-plugin-oxlint": "^1.64.0",
			"@types/bun": "^1.3.14",
			"@types/node": "latest",
			"@types/react": "19.2.15",
			"@types/react-dom": "19.2.3",
			"eslint": "^9.39.4",
			"tsup": "^8.3.6",
			"sqlite-vec": "^0.1.1"
		}
	},
	"scripts": {
		"bot:dev": "bun --filter @shenron/bot dev",
		"bot:start": "bun --filter @shenron/bot start",
		"bot:build": "bun --filter @shenron/bot build",
		"bot:test": "bun --filter @shenron/bot test",
		"bot:lint": "bun --filter @shenron/bot lint",
		"site:dev": "bun --filter @shenron/site dev",
		"site:build": "bun --filter @shenron/site build",
		"site:start": "bun --filter @shenron/site start",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"build": "turbo run build",
		"dev": "turbo run dev",
		"test": "turbo run test",
		"test:all": "bun scripts/test-all.ts",
		"test:ci": "bun scripts/test-all.ts --strict",
		"test:cov": "bun scripts/test-all.ts --coverage --junit",
		"test:live": "bun scripts/test-all.ts --live",
		"rag:eval": "bun --filter @shenron/bot rag:eval",
		"type-check": "turbo run type-check",
		"clean": "turbo run clean && rm -rf node_modules .turbo",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"docs:unify": "bun scripts/docs/unify-markdown.ts"
	},
	"devDependencies": {
		"turbo": "^2.5.10",
		"tsup": "catalog:",
		"oxlint": "catalog:",
		"oxfmt": "catalog:"
	},
	"packageManager": "bun@1.3.14",
	"dependencies": {
		"sharp": "^0.34.5",
		"vercel": "^54.2.0"
	}
}
