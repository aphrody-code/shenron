[Unit]
Description=filebrowser — serveur de fichiers + upload (files.dragonballfr.com)
After=network.target network-online.target
Wants=network-online.target
StartLimitBurst=10
StartLimitIntervalSec=600

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/filebrowser

# Bind loopback uniquement — l'exposition publique passe par nginx (TLS + rate-limit).
# Racine servie = tout le dépôt shenron (accès complet demandé). Le reste de
# la config (locale fr, branding, thème) vit dans la DB filebrowser.
ExecStart=/usr/local/bin/filebrowser \
  -d /home/ubuntu/filebrowser/filebrowser.db \
  -a 127.0.0.1 -p 8081 \
  -r /home/ubuntu/shenron

ExecStop=/bin/kill -SIGTERM $MAINPID
TimeoutStopSec=20
KillMode=mixed
KillSignal=SIGTERM

Restart=always
RestartSec=5

MemoryMax=512M
MemoryHigh=384M
TasksMax=128
LimitNOFILE=65536
OOMScoreAdjust=-100
CPUWeight=60
IOWeight=60

# Hardening (calqué sur shenron-embed.service)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete @privileged

# DB filebrowser + dépôt shenron (racine servie) writable ; le reste de /home
# reste en lecture seule (ProtectHome), protégeant ~/.ssh, ~/.config, secrets.
ReadWritePaths=/home/ubuntu/filebrowser /home/ubuntu/shenron

StandardOutput=journal
StandardError=journal
SyslogIdentifier=filebrowser

[Install]
WantedBy=multi-user.target
