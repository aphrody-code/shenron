[Unit]
Description=Purge des lecteurs (players) episodes/films morts cote hebergeurs tiers
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/shenron
EnvironmentFile=/home/ubuntu/.shenron-neon.env
ExecStart=/home/ubuntu/.bun/bin/bun apps/bot/scripts/prune-dead-embed-players.ts
TimeoutStartSec=1800
Nice=15

[Install]
WantedBy=multi-user.target
