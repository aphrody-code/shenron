[Unit]
Description=Backup PostgreSQL local du site (shenron_site : public+bot, pg_dump + gzip + retention 14d)
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=/home/ubuntu/.shenron-neon.env
ExecStart=/home/ubuntu/shenron/scripts/backup-shenron-pg.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=shenron-pg-backup
