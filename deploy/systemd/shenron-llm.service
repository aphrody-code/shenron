[Unit]
Description=shenron-llm — serveur LLM local (llama.cpp, Qwen2.5-3B-Instruct, CPU) servant le chat conversationnel du bot/site
After=network.target network-online.target
Wants=network-online.target
StartLimitBurst=10
StartLimitIntervalSec=600

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/llama.cpp

# llama.cpp lie dynamiquement ses libs (libllama/libggml) -> LD_LIBRARY_PATH requis.
Environment=LD_LIBRARY_PATH=/home/ubuntu/llama.cpp/build/bin
# OpenAI-compatible sur :5008 (cf. LOCAL_LLM_URL dans apps/bot/src/lib/llm.ts).
ExecStart=/home/ubuntu/llama.cpp/build/bin/llama-server \
  -m /home/ubuntu/shenron/apps/bot/.models/qwen2.5-3b-instruct-q4_k_m.gguf \
  --host 127.0.0.1 --port 5008 -c 4096 -t 11 --threads-batch 11 --no-webui

ExecStop=/bin/kill -SIGTERM $MAINPID
TimeoutStopSec=20
KillMode=mixed
KillSignal=SIGTERM

Restart=always
RestartSec=5

# Qwen2.5-3B Q4_K_M (~1.9 Go) + KV cache (ctx 4096) + overhead. Aucun plafond :
# le LLM peut prendre toute la RAM disponible (ctx plus large, batch plus gros).
MemoryAccounting=true
LimitNOFILE=65536
OOMScoreAdjust=-150
CPUWeight=90
IOWeight=80

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete @privileged

StandardOutput=journal
StandardError=journal
SyslogIdentifier=shenron-llm

[Install]
WantedBy=multi-user.target
