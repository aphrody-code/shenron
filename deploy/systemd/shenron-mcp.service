[Unit]
Description=shenron-mcp — serveur MCP public (RAG + API publique Dragon Ball) sur :5010
After=network.target network-online.target shenron.service
Wants=network-online.target
StartLimitBurst=15
StartLimitIntervalSec=600

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/shenron/apps/mcp

Environment=NODE_ENV=production
Environment=MCP_PORT=5010
Environment=MCP_HOST=127.0.0.1
Environment=MCP_PUBLIC_URL=https://mcp.dragonballfr.com
EnvironmentFile=-/etc/shenron/mcp-admin.env
# Proxy lecture seule vers l'API publique du bot (loopback).
Environment=SHENRON_API_URL=http://127.0.0.1:5006
Environment=SHENRON_SITE_URL=https://dragonballfr.com
# API databooks du site (Next). Nom public et non port loopback : le site
# tourne en bleu/vert, le port du slot actif change à chaque déploiement.
Environment=SHENRON_SITE_API_URL=https://dragonballfr.com
Environment=BUN_RUNTIME_TRANSPILER_CACHE_PATH=/home/ubuntu/shenron/apps/mcp/.bun-cache

ExecStart=/home/ubuntu/.bun/bin/bun src/index.ts

ExecStop=/bin/kill -SIGTERM $MAINPID
TimeoutStopSec=15
KillMode=mixed
KillSignal=SIGTERM
# Bun sort en 143 (128+SIGTERM) au lieu de mourir du signal : sans cette ligne
# systemd marque l'unité `failed` à CHAQUE arrêt propre (diagnostic pollué,
# watchdog qui voit une unit en échec). Repris de rose-griffon/rg.
SuccessExitStatus=143

Restart=always
RestartSec=5

# Proxy léger (pas de modèle, pas de canvas). Aucun plafond : cohérent avec le
# reste de la stack, le VPS n'est pas partagé avec d'autres locataires.
MemoryAccounting=true
LimitNOFILE=65536
OOMScoreAdjust=-100
CPUWeight=100
IOWeight=100

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete @privileged

ReadWritePaths=/home/ubuntu/shenron/apps/mcp/.bun-cache

StandardOutput=journal
StandardError=journal
SyslogIdentifier=shenron-mcp

[Install]
WantedBy=multi-user.target
