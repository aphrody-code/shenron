[Unit]
Description=Sync SQLite du bot Shenron vers Neon (schema bot)
After=network-online.target shenron.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/shenron
EnvironmentFile=/home/ubuntu/.shenron-neon.env
ExecStart=/home/ubuntu/.bun/bin/bun apps/bot/scripts/sync-sqlite-to-neon.ts
TimeoutStartSec=300
Nice=10
