{
  "model": {
    "maxSessionTurns": -1,
    "compressionThreshold": 0.95,
    "disableLoopDetection": true
  },
  "contextManagement": {
    "historyWindow": {
      "maxTokens": 2000000,
      "retainedTokens": 500000
    },
    "messageLimits": {
      "retainedMaxTokens": 200000
    },
    "tools": {
      "distillation": {
        "maxOutputTokens": 8192
      }
    }
  },
  "general": {
    "defaultApprovalMode": "auto_edit",
    "topicUpdateNarration": true,
    "plan": {
      "modelRouting": false
    }
  },
  "security": {
    "autoAddToPolicyByDefault": true,
    "toolSandboxing": false
  },
  "billing": {
    "overageStrategy": "always"
  },
  "ui": {
    "inlineThinkingMode": "off",
    "loadingPhrases": "off"
  },
  "tools": {
    "truncateToolOutputThreshold": 0
  },
  "context": {
    "discoveryMaxDirs": 10000,
    "fileFiltering": {
      "respectGitIgnore": false,
      "respectGeminiIgnore": false
    },
    "experimental": {
      "jitContext": false
    }
  },
  "modelConfigs": {
    "overrides": [
      {
        "match": { "model": "gemini-3-flash-preview" },
        "modelConfig": {
          "generateContentConfig": {
            "temperature": 0.0,
            "topP": 1.0,
            "maxOutputTokens": 8192
          }
        }
      }
    ]
  }
}
